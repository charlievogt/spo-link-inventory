{
  "name": "@spo-link-inventory/func",
  "version": "0.1.0",
  "description": "Azure Function backend for spo-link-inventory: page + document scanner, find-and-replace, backlinks index, duplicate detection",
  "main": "dist/src/index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "pretest": "tsc -p tsconfig.test.json",
