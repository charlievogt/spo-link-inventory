    "start": "func start",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.0",
    "@azure/functions": "^4.6.0",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "@azure/storage-queue": "^12.29.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "azure-functions-core-tools": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "brace-expansion": "^2.0.3"
  }
}
